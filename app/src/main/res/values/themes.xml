<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main app theme -->
    <style name="Theme.PulseMusicPlayerAI" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#0B0820</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash screen theme: dark window background so launch feels instant & premium
         (matches the SplashScreen deep-navy gradient) before Compose draws -->
    <style name="Theme.PulseMusicPlayerAI.Splash" parent="Theme.PulseMusicPlayerAI">
        <item name="android:windowBackground">@drawable/splash_window_background</item>
    </style>
</resources>
